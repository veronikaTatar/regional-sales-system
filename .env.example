# Docker Compose reads this file after you copy it to .env.
# Replace both passwords with distinct, strong values before starting containers.
MYSQL_DATABASE=regional_sales
MYSQL_USER=regional_sales
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Spring Boot does not automatically load this file. Export variables in your shell.
DB_URL=jdbc:mysql://localhost:3306/regional_sales?connectionTimeZone=UTC
DB_USERNAME=regional_sales
DB_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Optional. Register a Web application in Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Optional first administrator. All three credentials must be set together.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Администратор системы
